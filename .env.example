# ==============================================================================
# EPSON-PAPERLESS-SMART-BRIDGE CONFIGURATION TEMPLATE
# Copy to .env and configure with your environment values: cp .env.example .env
# ==============================================================================

# 1. Paperless-ngx Admin Credentials
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=your_secure_password_here
PAPERLESS_ADMIN_MAIL=admin@yourdomain.local
PAPERLESS_SECRET_KEY=generate_a_random_secret_key_here
POSTGRES_PASSWORD=your_postgres_password_here

# 2. Host Storage Paths (NAS / Host directories)
# UNRAID_APPDATA_ROOT: Fast SSD for DB, Redis, Scratch, Thumbnails
UNRAID_APPDATA_ROOT=/mnt/disks/QM00001/_HOMELAB/_DOCKER/_DOCKER_APPDATA/_PAPERLESS
# UNRAID_DOCS_ROOT: Large HDD array for PDF archive, JSON metadata, backups
UNRAID_DOCS_ROOT=/mnt/user/_HERMES_WORKDIR/DOKUMENTUMOK

# 3. Network & Printer Settings
PRINTER_IP=192.168.0.90
# Network interface on the host bridged to LAN (e.g. eth0, ens18, br0)
LAN_INTERFACE=ens18
LAN_SUBNET=192.168.0.0/24
LAN_GATEWAY=192.168.0.1

# 4. AI Categorization Provider Configuration
# Supported providers: openai, openai-oauth, ollama, gemini, minimax
AI_PROVIDER=openai-oauth
CODEX_MODEL=gpt-6-luna
CODEX_OAUTH_DIR=/mnt/user/_HERMES_WORKDIR/.codex_oauth

# Fallback / Alternative AI API Keys (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_URL=http://192.168.0.77:11434
OLLAMA_MODEL=gemma3:4b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=minimax-m3

# 5. Gmail IMAP / OAuth Fetching (Optional)
PAPERLESS_GMAIL_OAUTH_CLIENT_ID=
PAPERLESS_GMAIL_OAUTH_CLIENT_SECRET=
